# Copy this file to .env and replace placeholders with real secrets.
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=auth_db
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432

SECRET_KEY=replace_with_secure_secret

# Email provider (`smtp`, `brevo_api`, `resend_api`)
EMAIL_PROVIDER=resend_api
# Resend API (recommended: HTTPS/443, avoids SMTP port issues on some VPS networks)
RESEND_API_KEY=your_resend_api_key
RESEND_API_URL=https://api.resend.com/emails
# Brevo transactional API (optional alternative)
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
# SMTP settings (optional fallback / alternative providers)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_login
SMTP_PASSWORD=your_smtp_password
# Must be a verified sender in your provider (Resend/Brevo/etc)
EMAILS_FROM_EMAIL=Amio Service <noreply@your-domain.com>
APP_PUBLIC_URL=http://localhost:5173
MARKETPLACE_SERVICE_URL=http://host.docker.internal:8002
FAVORITES_REFRESH_POLL_SECONDS=60
FAVORITES_REFRESH_BATCH_SIZE=50
FAVORITES_REFRESH_CONCURRENCY=3
FAVORITES_HISTORY_RETENTION_DAYS=30
FAVORITES_MARKETPLACE_TIMEOUT_SECONDS=15

# Marketplace service
ENABLE_WB=1
ENABLE_OZON=1
ENABLE_YM=1
MAX_ITEMS=120
PAGE_ITEMS=24
WB_ITEMS=25
OZON_ITEMS=15
YM_ITEMS=20

# Hard budgets (seconds). Keep below 5s total response time.
WB_TOTAL_BUDGET=3.5
WB_API_TIMEOUT=3.2
WB_MAX_PAGES=1
WB_MIN_INTERVAL=0.45
WB_MAX_RETRIES=5
WB_429_COOLDOWN=2.0
WB_BLOCK_MAX_WAIT=0.8
WB_CONCURRENT_LIMIT=4
# Optional WB UA rotation (separate multiple values with ||)
WB_USER_AGENTS=
# Optional HTTP proxies for WB (comma-separated)
WB_PROXY_URLS=
OZON_TOTAL_BUDGET=4.0
YM_TOTAL_BUDGET=3.5
YM_API_TIMEOUT=4.0
YM_MAX_PAGES=1
YM_CACHE_TTL=300
HOMEPAGE_CACHE_TTL=3600
# Optional region tuning for Yandex Market (leave empty for default).
YM_LR=
YM_GPS=

# Ozon browser tuning
CHROME_HEADLESS=1
OZON_PAGE_LOAD_STRATEGY=none
OZON_FAST_JS_EXTRACT=1
OZON_DRIVER_REUSE=1
OZON_WARMUP=1

# Wildberries images
WB_IMAGE_EXT=webp
WB_IMAGE_HOSTS=wbbasket.ru,wb.ru,wbcontent.net
WB_IMAGE_SIZES=big,c516x688,c246x328

# WB image proxy (fixes missing images due to basket mismatch)
WB_USE_IMAGE_PROXY=1
WB_IMAGE_PROXY_TIMEOUT=1.2
WB_IMAGE_PROXY_TTL=3600
# When enabled, backend probes multiple basket hosts via HEAD (more WB requests).
# Keep it off unless you really need it.
WB_IMAGE_PROXY_PROBE=0
WB_IMAGE_PROBE_MAX_BASKETS=6

# Wildberries rate limiting / cache
WB_MIN_INTERVAL=0.45
WB_429_COOLDOWN=2.0
WB_CACHE_TTL=300
WB_CACHE_STALE_TTL=1800

# Ozon cache
OZON_CACHE_TTL=300
